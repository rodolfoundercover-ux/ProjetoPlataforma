      "args": [
        "exec",
        "--yes",
        "--package=pnpm@11.19.0",
        "--",
        "pnpm",
        "db:types"
      ],
      "problemMatcher": []
    },
    {
      "label": "PHASE_00: testar banco",
      "type": "shell",
