{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "PHASE_00: instalar dependências",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-File",
        "scripts/setup-local.ps1"
      ],
      "problemMatcher": []
    },
    {
      "label": "PHASE_00: iniciar Supabase",
      "type": "shell",
      "command": "npm",
      "args": [
        "exec",
        "--yes",
        "--package=pnpm@11.19.0",
        "--",
        "pnpm",
        "local:start"
      ],
      "problemMatcher": []
    },
    {
      "label": "PHASE_00: configurar ambiente",
      "type": "shell",
      "command": "npm",
      "args": [
        "exec",
        "--yes",
        "--package=pnpm@11.19.0",
        "--",
        "pnpm",
        "local:env"
      ],
      "problemMatcher": []
    },
    {
      "label": "PHASE_00: gerar tipos do banco",
      "type": "shell",
