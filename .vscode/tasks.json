        "exec",
        "--yes",
        "--package=pnpm@11.19.0",
        "--",
        "pnpm",
        "check"
      ],
      "problemMatcher": []
    },
    {
      "label": "PHASE_00: abrir servidor web",
      "type": "shell",
      "command": "npm",
      "args": [
        "exec",
        "--yes",
        "--package=pnpm@11.19.0",
        "--",
        "pnpm",
