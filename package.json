{
  "name": "travel-platform",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "packageManager": "pnpm@11.19.0",
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:smoke": "node --test tests/smoke/*.test.mjs",
    "test:e2e": "playwright test",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "local:start": "supabase start",
    "local:stop": "supabase stop",
    "local:env": "node scripts/local-env.mjs",
    "db:test": "supabase test db",
    "db:types": "node scripts/db-types.mjs"
  },
  "dependencies": {
    "next": "16.3.4",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "@supabase/ssr": "0.8.0",
    "@supabase/supabase-js": "2.116.0",
    "zod": "4.6.2",
    "server-only": "0.0.1"
  },
  "devDependencies": {
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "typescript": "5.9.3",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.4",
    "tailwindcss": "4.2.1",
    "@tailwindcss/postcss": "4.2.1",
    "vitest": "4.1.11",
    "@playwright/test": "1.63.0",
    "supabase": "2.117.0"
  }
}
